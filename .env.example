# Discord OAuth2 application used for dashboard sign-in
DASHBOARD_CLIENT_ID=
DASHBOARD_CLIENT_SECRET=
DASHBOARD_REDIRECT_URI=https://YOUR_DOMAIN/dashboard/callback

# Generate with: openssl rand -hex 32
DASHBOARD_SESSION_SECRET=

# Optional additional developer Discord user IDs, comma-separated.
# The existing maker owner is already trusted by the dashboard.
DASHBOARD_DEVELOPER_IDS=

# Existing bot runtime secrets (configure separately in hosting)
BOT_TOKENS=
TOKEN_ENCRYPTION_KEY=
